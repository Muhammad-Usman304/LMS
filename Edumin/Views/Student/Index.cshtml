@model IEnumerable<Edumin.Models.Student>

@{
	Layout = "~/Views/Shared/_LayoutEdumin.cshtml";
	ViewData["Title"] = "All Students";
}

<div class="content-body">
	<div class="container-fluid">

		<div class="row page-titles mx-0">
			<div class="col-sm-6 p-md-0">
				<div class="welcome-text">
					<h4>All Students</h4>
				</div>
			</div>
			<div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a href="javascript:void(0);">Students</a></li>
					<li class="breadcrumb-item active"><a href="javascript:void(0);">All Students</a></li>
				</ol>
			</div>
		</div>

		<div class="row">
			<div class="col-lg-12">
				<ul class="nav nav-pills mb-3">
					<li class="nav-item">
						<a href="#list-view" data-bs-toggle="tab" class="nav-link me-1 show active">List View</a>
					</li>
					<li class="nav-item">
						<a href="#grid-view" data-bs-toggle="tab" class="nav-link">Grid View</a>
					</li>
				</ul>
			</div>

			<div class="col-lg-12">
				<div class="row tab-content">

					<!-- LIST VIEW -->
					<div id="list-view" class="tab-pane fade active show col-lg-12">
						<div class="card">
							<div class="card-header">
								<h4 class="card-title">All Students List</h4>
								<a asp-controller="Student" asp-action="Create" class="btn btn-primary">+ Add New</a>
							</div>
							<div class="card-body">
								<div class="table-responsive">
									<table id="example3" class="display text-nowrap" style="min-width: 1200px">
										<thead>
											<tr>
												<th>#</th>
												<th>Roll No</th>
												<th>Name</th>
												<th>Email</th>
												<th>Mobile</th>
												<th>Parent Name</th>
												<th>Parent Mobile</th>
												<th>Registration Date</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											@if (Model != null && Model.Any())
											{
												int sr = 1;
												foreach (var item in Model)
												{
													<tr>
														<td><strong>@sr</strong></td>
														<td>@item.RollNo</td>
														<td>@item.FirstName @item.LastName</td>
														<td>@item.Email</td>
														<td>@item.MobileNumber</td>
														<td>@item.ParentName</td>
														<td>@item.ParentMobileNumber</td>
														<td>@item.RegistrationDate.ToString("dd-MM-yyyy")</td>
														<td>
															<a asp-controller="Student"
															   asp-action="Edit"
															   asp-route-id="@item.StudentId"
															   class="btn btn-xs sharp btn-primary">
																<i class="fa fa-pencil"></i>
															</a>

															<a asp-controller="Student"
															   asp-action="Delete"
															   asp-route-id="@item.StudentId"
															   class="btn btn-xs sharp btn-danger"
															   onclick="return confirm('Are you sure you want to delete this student?');">
																<i class="fa fa-trash"></i>
															</a>
														</td>
													</tr>
													sr++;
												}
											}
											else
											{
												<tr>
													<td colspan="9" class="text-center">No students found.</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>

					<!-- GRID VIEW -->
					<div id="grid-view" class="tab-pane fade col-lg-12">
						<div class="row">
							@if (Model != null && Model.Any())
							{
								foreach (var item in Model)
								{
									<div class="col-lg-4 col-md-6 col-sm-6 col-12">
										<div class="card card-profile">
											<div class="card-header justify-content-end pb-0 border-0">
												<div class="dropdown">
													<button class="btn btn-link" type="button" data-bs-toggle="dropdown">
														<span class="dropdown-dots fs--1"></span>
													</button>
													<div class="dropdown-menu dropdown-menu-right border py-0">
														<div class="py-2">
															<a class="dropdown-item"
															   asp-controller="Student"
															   asp-action="Edit"
															   asp-route-id="@item.StudentId">Edit</a>

															<a class="dropdown-item text-danger"
															   asp-controller="Student"
															   asp-action="Delete"
															   asp-route-id="@item.StudentId"
															   onclick="return confirm('Are you sure you want to delete this student?');">Delete</a>
														</div>
													</div>
												</div>
											</div>

											<div class="card-body pt-2">
												<div class="text-center">
													<div class="profile-photo">
														<img src="~/edumin/images/profile/small/pic1.jpg" width="100" class="img-fluid rounded-circle" alt="">
													</div>

													<h3 class="mt-4 mb-1">@item.FirstName @item.LastName</h3>
													<p class="text-muted">Roll No: @item.RollNo</p>

													<ul class="list-group mb-3 list-group-flush">
														<li class="list-group-item px-0 d-flex justify-content-between">
															<span class="mb-0">Email :</span>
															<strong>@item.Email</strong>
														</li>
														<li class="list-group-item px-0 d-flex justify-content-between">
															<span class="mb-0">Mobile :</span>
															<strong>@item.MobileNumber</strong>
														</li>
														<li class="list-group-item px-0 d-flex justify-content-between">
															<span class="mb-0">Parent :</span>
															<strong>@item.ParentName</strong>
														</li>
														<li class="list-group-item px-0 d-flex justify-content-between">
															<span class="mb-0">Reg. Date :</span>
															<strong>@item.RegistrationDate.ToString("dd-MM-yyyy")</strong>
														</li>
													</ul>

													<a asp-controller="Student"
													   asp-action="Edit"
													   asp-route-id="@item.StudentId"
													   class="btn btn-outline-primary btn-rounded mt-3 px-4">
														Edit Student
													</a>
												</div>
											</div>
										</div>
									</div>
								}
							}
							else
							{
								<div class="col-12">
									<div class="alert alert-info text-center">
										No students found.
									</div>
								</div>
							}
						</div>
					</div>

				</div>
			</div>
		</div>

	</div>
</div>

@section Edumin_style
{
	<link href="~/edumin/vendor/datatables/css/jquery.dataTables.min.css" rel="stylesheet">
}

@section Edumin_script
{
	<script src="~/edumin/vendor/global/global.min.js"></script>
	<script src="~/edumin/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
	<script src="~/edumin/vendor/datatables/js/jquery.dataTables.min.js"></script>
	<script src="~/edumin/js/plugins-init/datatables.init.js"></script>
	<script src="~/edumin/vendor/svganimation/vivus.min.js"></script>
	<script src="~/edumin/vendor/svganimation/svg.animation.js"></script>
	<script src="~/edumin/js/custom.min.js"></script>
	<script src="~/edumin/js/dlabnav-init.js"></script>
}