@model IEnumerable<Edumin.Models.TeacherModel>

@{
	Layout = "~/Views/Shared/_LayoutEdumin.cshtml";
	ViewData["Title"] = "All Teachers";
}

<div class="content-body">
	<div class="container-fluid">

		<div class="row page-titles mx-0">
			<div class="col-sm-6 p-md-0">
				<div class="welcome-text">
					<h4>All Teachers</h4>
				</div>
			</div>
			<div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a href="javascript:void(0);">Teachers</a></li>
					<li class="breadcrumb-item active"><a href="javascript:void(0);">All Teachers</a></li>
				</ol>
			</div>
		</div>

		<div class="row">
			<div class="col-lg-12">
				<ul class="nav nav-pills mb-3">
					<li class="nav-item"><a href="#list-view" data-bs-toggle="tab" class="nav-link me-1 show active">List View</a></li>
					<li class="nav-item"><a href="#grid-view" data-bs-toggle="tab" class="nav-link">Grid View</a></li>
				</ul>
			</div>

			<div class="col-lg-12">
				<div class="row tab-content">
					<div id="list-view" class="tab-pane fade active show col-lg-12">
						<div class="card">
							<div class="card-header">
								<h4 class="card-title">All Teachers</h4>
								<a asp-controller="Teacher" asp-action="Create" class="btn btn-primary">+ Add new</a>
							</div>
							<div class="card-body">
								<div class="table-responsive">
									<table id="example3" class="display text-nowrap" style="min-width: 845px">
										<thead>
											<tr>
												<th>Profile</th>
												<th>Name</th>
												<th>Department</th>
												<th>Gender</th>
												<th>Education</th>
												<th>Mobile</th>
												<th>Email</th>
												<th>Joining Date</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var item in Model)
											{
												<tr>
													<td>
														<img class="rounded-circle" width="35"
															 src="@(string.IsNullOrWhiteSpace(item.ProfileImagePath) ? Url.Content("~/edumin/images/profile/small/pic1.jpg") : item.ProfileImagePath)"
															 alt="">
													</td>
													<td>@item.FirstName @item.LastName</td>
													<td>@item.DepartmentName</td>
													<td>@item.GenderName</td>
													<td>@item.Education</td>
													<td>
														<a href="javascript:void(0);"><strong>@item.MobileNumber</strong></a>
													</td>
													<td>
														<a href="javascript:void(0);"><strong>@item.Email</strong></a>
													</td>
													<td>@item.JoiningDate.ToString("yyyy/MM/dd")</td>
													<td>
														<a asp-controller="Teacher" asp-action="Edit" asp-route-id="@item.TeacherId" class="btn btn-xs sharp btn-primary">
															<i class="fa fa-pencil"></i>
														</a>
														<a asp-controller="Teacher" asp-action="Delete" asp-route-id="@item.TeacherId" class="btn btn-xs sharp btn-danger"
														   onclick="return confirm('Are you sure you want to delete this teacher?')">
															<i class="fa fa-trash"></i>
														</a>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>

					<div id="grid-view" class="tab-pane fade col-lg-12">
						<div class="row">
							@foreach (var item in Model)
							{
								<div class="col-lg-4 col-md-6 col-sm-6 col-12">
									<div class="card card-profile">
										<div class="card-header justify-content-end pb-0 border-0">
											<div class="dropdown">
												<button class="btn btn-link" type="button" data-bs-toggle="dropdown">
													<span class="dropdown-dots fs--1"></span>
												</button>
												<div class="dropdown-menu dropdown-menu-right border py-0">
													<div class="py-2">
														<a class="dropdown-item" asp-controller="Teacher" asp-action="Edit" asp-route-id="@item.TeacherId">Edit</a>
														<a class="dropdown-item text-danger"
														   asp-controller="Teacher"
														   asp-action="Delete"
														   asp-route-id="@item.TeacherId"
														   onclick="return confirm('Are you sure you want to delete this teacher?')">Delete</a>
													</div>
												</div>
											</div>
										</div>

										<div class="card-body pt-2">
											<div class="text-center">
												<div class="profile-photo">
													<img src="@(string.IsNullOrWhiteSpace(item.ProfileImagePath) ? Url.Content("~/edumin/images/profile/small/pic1.jpg") : item.ProfileImagePath)"
														 width="100" class="img-fluid rounded-circle" alt="">
												</div>
												<h3 class="mt-4 mb-1">@item.FirstName @item.LastName</h3>
												<p class="text-muted">@item.Education</p>
												<ul class="list-group mb-3 list-group-flush">
													<li class="list-group-item px-0 d-flex justify-content-between">
														<span class="mb-0">Gender :</span><strong>@item.GenderName</strong>
													</li>
													<li class="list-group-item px-0 d-flex justify-content-between">
														<span class="mb-0">Department :</span><strong>@item.DepartmentName</strong>
													</li>
													<li class="list-group-item px-0 d-flex justify-content-between">
														<span class="mb-0">Phone No. :</span><strong>@item.MobileNumber</strong>
													</li>
													<li class="list-group-item px-0 d-flex justify-content-between">
														<span class="mb-0">Email:</span><strong>@item.Email</strong>
													</li>
												</ul>
												<a class="btn btn-outline-primary btn-rounded mt-3 px-4"
												   asp-controller="Teacher"
												   asp-action="Edit"
												   asp-route-id="@item.TeacherId">Edit Profile</a>
											</div>
										</div>
									</div>
								</div>
							}
						</div>
					</div>

				</div>
			</div>
		</div>

	</div>
</div>

@section Edumin_style
{
	<link href="~/edumin/vendor/datatables/css/jquery.dataTables.min.css" rel="stylesheet">
}

@section Edumin_script
{
	<script src="~/edumin/vendor/global/global.min.js"></script>
	<script src="~/edumin/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
	<script src="~/edumin/vendor/datatables/js/jquery.dataTables.min.js"></script>
	<script src="~/edumin/js/plugins-init/datatables.init.js"></script>
	<script src="~/edumin/vendor/svganimation/vivus.min.js"></script>
	<script src="~/edumin/vendor/svganimation/svg.animation.js"></script>
	<script src="~/edumin/js/custom.min.js"></script>
	<script src="~/edumin/js/dlabnav-init.js"></script>
}