@model Edumin.Models.ClassModel

@{
    var isEdit = Model != null && Model.ClassId > 0;
}

<form asp-controller="Class" asp-action="@(isEdit ? "Edit" : "Create")" method="post">

    <input type="hidden" asp-for="ClassId" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <label asp-for="ClassName" class="form-label"></label>
                <input asp-for="ClassName" class="form-control" placeholder="Enter Class Name" />
                <span asp-validation-for="ClassName" class="text-danger"></span>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12">
            <button type="submit" class="btn btn-primary">
                @(isEdit ? "Update Class" : "Add Class")
            </button>

            <a asp-controller="Class" asp-action="Index" class="btn btn-danger light">
                Cancel
            </a>
        </div>
    </div>
</form>