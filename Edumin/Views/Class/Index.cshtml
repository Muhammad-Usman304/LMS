@model IEnumerable<Edumin.Models.ClassModel>

@{
	Layout = "~/Views/Shared/_LayoutEdumin.cshtml";
	ViewData["Title"] = "All Classes";
}

<div class="content-body">
	<div class="container-fluid">

		<div class="row page-titles mx-0">
			<div class="col-sm-6 p-md-0">
				<div class="welcome-text">
					<h4>All Classes</h4>
				</div>
			</div>
			<div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a href="javascript:void(0);">Classes</a></li>
					<li class="breadcrumb-item active"><a href="javascript:void(0);">All Classes</a></li>
				</ol>
			</div>
		</div>

		<div class="row">
			<div class="col-lg-12">
				<div class="card">
					<div class="card-header">
						<h4 class="card-title">All Classes List</h4>
						<a asp-controller="Class" asp-action="Create" class="btn btn-primary">+ Add New</a>
					</div>
					<div class="card-body">
						<div class="table-responsive">
							<table id="example3" class="display text-nowrap" style="min-width: 700px">
								<thead>
									<tr>
										<th>#</th>
										<th>Class Name</th>
										<th>Action</th>
									</tr>
								</thead>
								<tbody>
									@if (Model != null && Model.Any())
									{
										int sr = 1;
										foreach (var item in Model)
										{
											<tr>
												<td><strong>@sr</strong></td>
												<td>@item.ClassName</td>
												<td>
													<a asp-controller="Class"
													   asp-action="Edit"
													   asp-route-id="@item.ClassId"
													   class="btn btn-xs sharp btn-primary">
														<i class="fa fa-pencil"></i>
													</a>

													<a asp-controller="Class"
													   asp-action="Delete"
													   asp-route-id="@item.ClassId"
													   class="btn btn-xs sharp btn-danger"
													   onclick="return confirm('Are you sure you want to delete this class?');">
														<i class="fa fa-trash"></i>
													</a>
												</td>
											</tr>
											sr++;
										}
									}
									else
									{
										<tr>
											<td colspan="3" class="text-center">No classes found.</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>
</div>

@section Edumin_style
{
	<link href="~/edumin/vendor/datatables/css/jquery.dataTables.min.css" rel="stylesheet">
}

@section Edumin_script
{
	<script src="~/edumin/vendor/global/global.min.js"></script>
	<script src="~/edumin/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
	<script src="~/edumin/vendor/datatables/js/jquery.dataTables.min.js"></script>
	<script src="~/edumin/js/plugins-init/datatables.init.js"></script>
	<script src="~/edumin/vendor/svganimation/vivus.min.js"></script>
	<script src="~/edumin/vendor/svganimation/svg.animation.js"></script>
	<script src="~/edumin/js/custom.min.js"></script>
	<script src="~/edumin/js/dlabnav-init.js"></script>
}